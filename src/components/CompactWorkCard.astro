---
import { Image } from 'astro:assets'

interface Props {
  title: string
  kicker: string
  summary: string
  href: string
  image?: ImageMetadata
  imageAlt?: string
  externalHref?: string // live site
}

const { title, kicker, summary, href, image, imageAlt, externalHref } = Astro.props
---

<a href={href} class="cw">
  <div class="cw__media">
    {image ? (
      <Image
        src={image}
        alt={imageAlt || `${title} — preview`}
        widths={[400, 720, 1080]}
        sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 360px"
        loading="lazy"
        decoding="async"
        class="cw__img"
      />
    ) : (
      <div class="cw__placeholder" aria-hidden="true"><span>{title.slice(0,2).toUpperCase()}</span></div>
    )}
  </div>
  <div class="cw__body">
    <div class="cw__kicker">{kicker}</div>
    <h3 class="cw__title">{title}</h3>
    <p class="cw__summary">{summary}</p>
    <span class="cw__cta">View project <span aria-hidden="true">→</span></span>
  </div>
</a>

{externalHref && (
  <span class="sr-only">Live: {externalHref}</span>
)}

<style>
  .cw {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-default), box-shadow var(--duration-base) var(--ease-default), transform var(--duration-base) var(--ease-out);
    will-change: transform;
  }
  .cw:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .cw:active { transform: scale(0.99); }
  .cw:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .cw__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface-raised);
    border-bottom: var(--border-hairline);
  }
  .cw__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 420ms var(--ease-out);
  }
  .cw:hover .cw__img { transform: scale(1.02); }
  @media (prefers-reduced-motion: reduce) {
    .cw__img { transition: none; }
    .cw:hover .cw__img { transform: none; }
  }

  .cw__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-text-faint);
    background: linear-gradient(180deg, var(--color-surface-raised), var(--color-surface));
  }

  .cw__body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .cw__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-faint);
    line-height: 1.4;
  }
  .cw__title {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--color-text);
  }
  .cw__summary {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cw__cta {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--duration-fast) var(--ease-default);
  }
  .cw:hover .cw__cta { color: var(--color-accent); }
</style>
