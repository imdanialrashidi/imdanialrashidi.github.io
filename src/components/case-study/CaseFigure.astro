---
import { Image } from "astro:assets";

interface Props {
  caption?: string;
  alt?: string;
  image?: ImageMetadata;
  label?: string;
  variant?: "default" | "accent";
  placeholderTitle?: string;
  placeholderInitials?: string;
  placeholderNote?: string;
}

const {
  caption,
  alt,
  image,
  label = "Figure",
  variant = "default",
  placeholderTitle = "Imagery to follow",
  placeholderInitials = "—",
  placeholderNote = "No fabricated interface — real screenshots will replace this frame when available.",
} = Astro.props;
---

<figure class:list={["cs-figure", variant === "accent" && "cs-figure--accent"]}>
  <div class="cs-figure__frame">
    {image ? (
      <Image
        src={image}
        alt={alt || caption || placeholderTitle}
        widths={[480, 720, 1080]}
        sizes="(max-width: 768px) 100vw, 42rem"
        loading="lazy"
        decoding="async"
        class="cs-figure__img"
      />
    ) : (
      <div class="cs-figure__placeholder" role="img" aria-label={`${placeholderTitle} — honest placeholder`}>
        <div class="cs-figure__grid" aria-hidden="true"></div>
        <div class="cs-figure__inner">
          <div class="cs-figure__top">
            <span class="cs-figure__badge">{label}</span>
            <span class="cs-figure__status">Placeholder — honest</span>
          </div>
          <div class="cs-figure__center">
            <span class="cs-figure__initials">{placeholderInitials}</span>
            <span class="cs-figure__title">{placeholderTitle}</span>
            <span class="cs-figure__rule" aria-hidden="true"></span>
          </div>
          <div class="cs-figure__foot">
            <span class="cs-figure__footText">{placeholderNote}</span>
          </div>
        </div>
      </div>
    )}
  </div>
  {caption && <figcaption class="cs-figure__caption">{caption}</figcaption>}
</figure>

<style>
  .cs-figure {
    margin: var(--space-6) 0;
    max-width: 66ch;
  }

  .cs-figure__frame {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: var(--border-hairline);
    background: var(--color-surface-raised);
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: stretch;
    isolation: isolate;
  }

  .cs-figure--accent .cs-figure__frame {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-border));
  }

  .cs-figure__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cs-figure__placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(12px, 2vw, 18px);
    background:
      linear-gradient(to right, color-mix(in srgb, var(--color-border) 55%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-border) 55%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
  }

  .cs-figure__grid {
    position: absolute;
    inset: 0;
    opacity: 0.38;
    background:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 100% 1px, 1px 100%;
    background-repeat: no-repeat;
    mask: linear-gradient(to bottom, transparent 0%, black 10%, black 88%, transparent 100%);
    pointer-events: none;
  }

  .cs-figure__inner {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid color-mix(in srgb, var(--color-border-strong) 72%, transparent);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(2px);
    border-radius: calc(var(--radius-lg) - 6px);
    padding: clamp(10px, 1.6vw, 16px);
    box-shadow: var(--shadow-sm);
  }

  .cs-figure--accent .cs-figure__inner {
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
  }

  .cs-figure__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .cs-figure__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 20px;
    padding: 0 8px;
    border-radius: var(--radius-pill);
    border: var(--border-hairline);
    background: var(--color-surface);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .cs-figure__status {
    font-weight: 500;
    opacity: 0.9;
    text-align: right;
    max-width: 18ch;
    line-height: 1.3;
  }

  .cs-figure__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-3) 0;
  }

  .cs-figure__initials {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3.8vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text);
    opacity: 0.88;
  }

  .cs-figure--accent .cs-figure__initials { color: var(--color-accent); }

  .cs-figure__title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cs-figure__rule {
    display: block;
    width: 32px;
    height: 1px;
    background: var(--color-border-strong);
    margin-top: var(--space-2);
    opacity: 0.8;
  }

  .cs-figure__foot {
    border-top: 1px solid var(--color-border);
    padding-top: 10px;
    display: flex;
    justify-content: center;
  }

  .cs-figure__footText {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-text-faint);
    text-align: center;
    max-width: 32ch;
    line-height: 1.4;
  }

  .cs-figure__caption {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-text-faint);
    max-width: 66ch;
    border-left: 2px solid var(--color-border);
    padding-left: 10px;
  }

  @media (max-width: 720px) {
    .cs-figure__frame { aspect-ratio: 16 / 11; }
  }
  @media (max-width: 375px) {
    .cs-figure__frame { aspect-ratio: 4 / 3; }
  }
</style>
