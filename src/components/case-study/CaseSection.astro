---
interface Props {
  num?: string;
  label: string;
  title: string;
  id?: string;
  intro?: string;
}

const { num, label, title, id, intro } = Astro.props;
---

<section class="cs-section" aria-labelledby={id} id={id}>
  <div class="container cs-section__inner">
    <div class="cs-section__head">
      <div class="cs-section__label">
        {num && <span class="cs-section__num">{num}</span>}
        <span class="cs-section__rule" aria-hidden="true"></span>
        <span class="cs-section__labelText">{label}</span>
      </div>
      <h2 id={id} class="cs-section__title">{title}</h2>
      {intro && <p class="cs-section__intro">{intro}</p>}
    </div>

    <div class="cs-section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .cs-section {
    padding: clamp(1.9rem, 4.5vw, 2.75rem) 0;
    border-top: var(--border-hairline);
  }

  .cs-section:first-of-type { border-top: none; }

  .cs-section__inner {
    max-width: var(--width-prose);
  }

  .cs-section__label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: var(--space-3);
  }

  .cs-section__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 20px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    border: var(--border-hairline);
    background: var(--color-surface);
    font-weight: 700;
    color: var(--color-text-muted);
    font-size: 10px;
  }

  .cs-section__rule {
    width: 24px;
    height: 1px;
    background: var(--color-border-strong);
    opacity: 0.7;
  }

  .cs-section__labelText { font-weight: 600; }

  .cs-section__title {
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.022em;
    font-weight: 680;
    text-wrap: balance;
    max-width: 22ch;
  }

  .cs-section__intro {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 62ch;
  }

  .cs-section__body {
    margin-top: clamp(1.1rem, 2.5vw, 1.6rem);
    /* Prose handles internal rhythm */
  }

  /* Prose inside sections — controlled measure */
  .cs-section__body :global(p) {
    font-size: var(--text-md);
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 66ch;
  }

  .cs-section__body :global(p + p) {
    margin-top: var(--space-4);
  }

  .cs-section__body :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 620;
    color: var(--color-text);
  }

  .cs-section__body :global(h3:first-child) { margin-top: 0; }

  .cs-section__body :global(ul),
  .cs-section__body :global(ol) {
    margin-top: var(--space-3);
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 66ch;
  }

  .cs-section__body :global(li::marker) {
    color: var(--color-text-faint);
  }

  .cs-section__body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .cs-section__body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 28%, transparent);
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease-default), text-decoration-color var(--duration-fast) var(--ease-default);
  }
  .cs-section__body :global(a:hover) {
    color: var(--color-accent-hover);
    text-decoration-color: var(--color-accent);
  }

  .cs-section__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-surface-raised);
    border: var(--border-hairline);
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .cs-section__body :global(pre) {
    margin-top: var(--space-4);
    padding: var(--space-4);
    background: var(--color-surface-raised);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-text);
  }
  .cs-section__body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .cs-section__body :global(hr) {
    margin: var(--space-6) 0;
    border: none;
    height: 1px;
    background: var(--color-border);
  }

  @media (max-width: 480px) {
    .cs-section__title { max-width: none; }
  }
</style>
