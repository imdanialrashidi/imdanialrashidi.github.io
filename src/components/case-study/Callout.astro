---
interface Props {
  variant?: "info" | "accent" | "muted";
  title?: string;
  icon?: string;
}

const { variant = "info", title, icon = "—" } = Astro.props;
---

<div class:list={["callout", `callout--${variant}`]} role="note">
  <div class="callout__head">
    <span class="callout__icon" aria-hidden="true">{icon}</span>
    {title && <span class="callout__title">{title}</span>}
  </div>
  <div class="callout__body">
    <slot />
  </div>
</div>

<style>
  .callout {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: var(--border-hairline);
    background: var(--color-surface);
    border-left-width: 3px;
    max-width: 66ch;
  }

  .callout--info {
    background: var(--color-surface);
    border-color: var(--color-border);
    border-left-color: var(--color-text-faint);
  }

  .callout--accent {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 14%, var(--color-border));
    border-left-color: var(--color-accent);
  }

  .callout--muted {
    background: var(--color-surface-raised);
    border-color: var(--color-border);
    border-left-color: var(--color-border-strong);
  }

  .callout__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-text-faint);
  }

  .callout--accent .callout__head { color: var(--color-accent); }

  .callout__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-surface-raised);
    border: var(--border-hairline);
    font-size: 10px;
    line-height: 1;
    flex-shrink: 0;
  }

  .callout--accent .callout__icon {
    background: var(--color-surface);
    border-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
    color: var(--color-accent);
  }

  .callout__title {
    color: inherit;
  }

  .callout__body {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .callout__body :global(p) {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: none;
  }

  .callout__body :global(p + p) { margin-top: var(--space-3); }
  .callout__body :global(strong) { color: var(--color-text); }
  .callout__body :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
</style>
