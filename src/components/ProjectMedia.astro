---
import { Image } from 'astro:assets'

interface Props {
  title: string
  indexLabel?: string // "01"
  statusLabel?: string // "Case study — in progress"
  image?: ImageMetadata // imported asset — when present, replaces abstract frame
  imageAlt?: string
  variant?: 'default' | 'accent'
}

const {
  title,
  indexLabel,
  statusLabel = 'Imagery to follow — honest placeholder',
  image,
  imageAlt,
  variant = 'default',
} = Astro.props

// Derive initials for abstract composition
const initials = title
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase()
---

<div class:list={["pm", variant === "accent" && "pm--accent"]} data-media>
  {image ? (
    <Image
      src={image}
      alt={imageAlt || `${title} — project imagery`}
      widths={[400, 720, 1080]}
      sizes="(max-width: 720px) 100vw, 58vw"
      loading="lazy"
      decoding="async"
      class="pm__img"
    />
  ) : (
    <div class="pm__frame" aria-hidden="true">
      <!-- subtle grid -->
      <div class="pm__grid" aria-hidden="true"></div>

      <div class="pm__inner">
        <div class="pm__top">
          <span class="pm__index">{indexLabel}</span>
          <span class="pm__status">{statusLabel}</span>
        </div>

        <div class="pm__center">
          <span class="pm__initials">{initials}</span>
          <span class="pm__title">{title}</span>
          <span class="pm__rule" aria-hidden="true"></span>
        </div>

        <div class="pm__foot">
          <span class="pm__foot-text">No fabricated interface — real screenshots will replace this frame</span>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .pm {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: var(--border-hairline);
    background: var(--color-surface-raised);
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: stretch;
    isolation: isolate;
  }

  .pm--accent {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-border));
  }

  .pm__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pm__frame {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(14px, 2.2vw, 22px);
    background:
      linear-gradient(to right, color-mix(in srgb, var(--color-border) 55%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-border) 55%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
  }

  /* subtle grid lines via pseudo */
  .pm__grid {
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 100% 1px, 1px 100%;
    background-repeat: no-repeat;
    mask: linear-gradient(to bottom, transparent 0%, black 10%, black 88%, transparent 100%);
    pointer-events: none;
  }

  .pm--accent .pm__frame {
    background-size: 28px 28px;
  }

  .pm__inner {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid color-mix(in srgb, var(--color-border-strong) 70%, transparent);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    backdrop-filter: blur(2px);
    border-radius: calc(var(--radius-lg) - 6px);
    padding: clamp(12px, 1.8vw, 18px);
    box-shadow: var(--shadow-sm);
  }

  .pm--accent .pm__inner {
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
  }

  .pm__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .pm__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 20px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    border: var(--border-hairline);
    background: var(--color-surface);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .pm__status {
    font-weight: 500;
    opacity: 0.9;
    text-align: right;
    max-width: 18ch;
    line-height: 1.3;
  }

  .pm__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-4) 0;
  }

  .pm__initials {
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text);
    opacity: 0.92;
  }

  .pm--accent .pm__initials {
    color: var(--color-accent);
  }

  .pm__title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .pm__rule {
    display: block;
    width: 36px;
    height: 1px;
    background: var(--color-border-strong);
    margin-top: var(--space-2);
    opacity: 0.8;
  }

  .pm__foot {
    border-top: 1px solid var(--color-border);
    padding-top: 10px;
    display: flex;
    justify-content: center;
  }

  .pm__foot-text {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-text-faint);
    text-align: center;
    max-width: 32ch;
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .pm {
      aspect-ratio: 16 / 11;
    }
    .pm__status {
      max-width: 14ch;
      font-size: 9px;
    }
    .pm__foot-text {
      max-width: 26ch;
    }
  }

  @media (max-width: 375px) {
    .pm {
      aspect-ratio: 4 / 3;
    }
  }
</style>
