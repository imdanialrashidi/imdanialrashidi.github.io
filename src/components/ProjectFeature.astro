---
import ProjectMedia from './ProjectMedia.astro'

interface Props {
  index: string // "01"
  title: string
  kicker: string
  summary: string
  href: string
  statusLabel?: string
  year?: number
  ctaLabel?: string
  variant?: 'default' | 'accent'
  reversed?: boolean
  image?: ImageMetadata
  imageAlt?: string
}

const {
  index,
  title,
  kicker,
  summary,
  href,
  statusLabel,
  year,
  ctaLabel = 'View case study',
  variant = 'default',
  reversed = false,
  image,
  imageAlt,
} = Astro.props
---

<article class:list={["pf", reversed && "pf--reversed", variant === "accent" && "pf--accent"]}>
  <div class="pf__media">
    <a href={href} class="pf__mediaLink" tabindex="-1" aria-hidden="true">
      <ProjectMedia title={title} indexLabel={index} statusLabel={statusLabel} variant={variant} image={image} imageAlt={imageAlt} />
    </a>
  </div>

  <div class="pf__content">
    <div class="pf__meta">
      <span class="pf__index">{index}</span>
      <span class="pf__rule" aria-hidden="true"></span>
      <span class="pf__kicker">{kicker}</span>
    </div>

    <h3 class="pf__title">
      <a href={href} class="pf__titleLink">{title}</a>
    </h3>

    <p class="pf__summary">{summary}</p>

    <div class="pf__details">
      {year && <span class="pf__year">{year}</span>}
      {statusLabel && <span class="pf__status">{statusLabel}</span>}
    </div>

    <a href={href} class="pf__cta" aria-label={`${ctaLabel} — ${title}`}>
      <span class="pf__ctaLabel">{ctaLabel}</span>
      <span class="pf__ctaArrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .pf {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
    padding: clamp(1rem, 2vw, 1.25rem);
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: var(--radius-xl);
    transition: border-color var(--duration-base) var(--ease-default), box-shadow var(--duration-base) var(--ease-default), transform var(--duration-base) var(--ease-out);
  }

  .pf:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .pf--accent {
    background: linear-gradient(180deg, var(--color-accent-soft) 0%, var(--color-surface) 62%);
    border-color: color-mix(in srgb, var(--color-accent) 10%, var(--color-border));
  }

  .pf--accent:hover {
    border-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-border-strong));
  }

  .pf--reversed {
    grid-template-columns: 0.82fr 1.18fr;
  }

  .pf--reversed .pf__media { order: 2; }
  .pf--reversed .pf__content { order: 1; }

  .pf__mediaLink {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    /* make hover propagate */
  }

  .pf__media {
    min-width: 0;
  }

  .pf__content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(0.5rem, 1.5vw, 1rem) 0;
  }

  .pf__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    flex-wrap: wrap;
  }

  .pf__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 22px;
    border-radius: var(--radius-pill);
    border: var(--border-hairline);
    background: var(--color-surface-raised);
    font-weight: 700;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .pf--accent .pf__index {
    background: var(--color-surface);
    border-color: color-mix(in srgb, var(--color-accent) 16%, var(--color-border));
    color: var(--color-accent);
  }

  .pf__rule {
    width: 20px;
    height: 1px;
    background: var(--color-border-strong);
    flex-shrink: 0;
  }

  .pf__kicker {
    color: var(--color-text-muted);
    font-weight: 600;
    line-height: 1.4;
    max-width: 32ch;
  }

  .pf--accent .pf__kicker { color: var(--color-accent); }

  .pf__title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    font-weight: 650;
    margin-top: -2px;
  }

  .pf__titleLink {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .pf__titleLink:hover,
  .pf__titleLink:focus-visible {
    color: var(--color-accent);
  }

  .pf__summary {
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 38ch;
  }

  .pf__details {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .pf__year {
    display: inline-flex;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    border: var(--border-hairline);
    background: var(--color-surface-raised);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .pf__status {
    font-weight: 500;
  }

  .pf__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-top: var(--space-1);
    padding: 9px 14px 9px 16px;
    border-radius: var(--radius-pill);
    border: var(--border-hairline);
    background: var(--color-text);
    color: var(--color-canvas);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: background var(--duration-fast) var(--ease-default), transform var(--duration-fast) var(--ease-default), border-color var(--duration-fast) var(--ease-default);
  }

  .pf__cta:hover {
    background: color-mix(in srgb, var(--color-text) 88%, var(--color-accent));
    border-color: transparent;
    transform: translateY(-1px);
  }

  .pf__cta:active { transform: scale(0.98); }

  .pf--accent .pf__cta {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  .pf--accent .pf__cta:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  /* Dark theme: white-on-accent needs >=4.5:1. Use pressed (darker) for sufficient contrast with white */
  :global(:root[data-theme="dark"] .pf--accent .pf__cta) {
    background: var(--color-accent-pressed);
    border-color: var(--color-accent-pressed);
    color: white;
  }

  :global(:root[data-theme="dark"] .pf--accent .pf__cta:hover) {
    background: #334ecc;
    border-color: #334ecc;
  }

  .pf__ctaArrow {
    display: inline-flex;
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, white 14%, transparent);
    font-size: 12px;
    line-height: 1;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .pf__cta:hover .pf__ctaArrow { transform: translateX(2px); }

  /* focus */
  .pf:focus-within {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 880px) {
    .pf,
    .pf--reversed {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .pf--reversed .pf__media { order: 1; }
    .pf--reversed .pf__content { order: 2; }
    .pf__content { padding: 0 2px 4px; }
    .pf__title { font-size: clamp(1.4rem, 5vw, 1.75rem); }
    .pf__summary { max-width: none; }
  }

  @media (max-width: 480px) {
    .pf { padding: 12px; border-radius: var(--radius-lg); }
    .pf__kicker { font-size: 10px; max-width: 22ch; }
  }
</style>
