---
import { type ProjectEntry, coverFor, hrefFor } from '../lib/work.ts'
import ProjectPlate from './ProjectPlate.astro'
import Shot from './Shot.astro'

interface Props {
  entry: ProjectEntry
  index: number
  flip?: boolean
  priority?: boolean
}

const { entry, index, flip = false, priority = false } = Astro.props
const cover = coverFor(entry)
---

<article class:list={["feature", { "feature--flip": flip }]}>
  <div class="feature__media">
    {
      cover ? (
        <Shot
          image={cover}
          alt={entry.data.coverAlt ?? `${entry.data.title} preview`}
          priority={priority}
          sizes="(max-width: 900px) 100vw, 58vw"
          widths={[640, 960, 1280, 1600]}
        />
      ) : (
        <ProjectPlate entry={entry} />
      )
    }
  </div>

  <div class="feature__body">
    <p class="eyebrow feature__eyebrow">
      <span aria-hidden="true">{String(index).padStart(2, "0")}</span>
      <span class="feature__divider" aria-hidden="true"></span>
      {entry.data.kicker}
    </p>
    <h3 class="h2 feature__title">
      <a href={hrefFor(entry)}>{entry.data.title}</a>
    </h3>
    <p class="feature__summary">{entry.data.summary}</p>
    <p class="feature__meta">
      <span>{entry.data.role}</span>
      <span aria-hidden="true">/</span>
      <span>{entry.data.year}</span>
      <span aria-hidden="true">/</span>
      <span class="status" data-status={entry.data.status}>{entry.data.statusLabel}</span>
    </p>
    <p class="feature__cta">
      <a class="link" href={hrefFor(entry)}>Read the {entry.data.kind === "product" ? "product" : "project"} case study</a>
    </p>
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .feature:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .feature__media {
    min-width: 0;
  }

  .feature__body {
    display: grid;
    gap: 0.75rem;
    align-content: center;
  }

  .feature__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
  }

  .feature__divider {
    width: 1.5rem;
    height: 1px;
    background: var(--line-strong);
  }

  .feature__title {
    margin: 0;
  }

  .feature__title a {
    text-decoration: none;
    color: var(--ink);
  }

  .feature__title a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.1em;
  }

  .feature__summary {
    color: var(--ink-soft);
    max-width: 30rem;
    font-size: var(--text-base);
  }

  .feature__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--ink-faint);
  }

  .feature__meta .status {
    font-size: inherit;
    margin-left: 0.4rem;
  }

  .feature__cta {
    margin-top: 0.5rem;
  }

  .feature__cta .link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 500;
  }

  @media (min-width: 901px) {
    .feature--flip .feature__media {
      order: 2;
    }
  }

  @media (max-width: 900px) {
    .feature {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
