---
import { navigation, social } from '../data/site.ts'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  currentPath?: string
}
const { currentPath = '/' } = Astro.props

function isActive(href: string, path: string) {
  if (href === '/') return path === '/'
  return path === href || path.startsWith(href + '/')
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <span class="site-header__name">Danial Rashidi</span>
      <span class="site-header__meta">Software &amp; Product Builder</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__list" role="list">
        {
          navigation.map((item) => {
            const active = isActive(item.href, currentPath);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={["site-header__link", { "site-header__link--active": active }]}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeToggle />
      <button
        id="menu-toggle"
        class="site-header__menu"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span class="site-header__menu-box" aria-hidden="true">
          <span class="site-header__menu-line"></span>
          <span class="site-header__menu-line"></span>
          <span class="site-header__menu-line"></span>
        </span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation — separate layer -->
  <div id="mobile-nav" class="mobile-nav" role="dialog" aria-modal="true" aria-label="Navigation menu" hidden>
    <div class="mobile-nav__inner container">
      <nav aria-label="Mobile">
        <ul class="mobile-nav__list" role="list">
          {
            navigation.map((item) => {
              const active = isActive(item.href, currentPath);
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={["mobile-nav__link", { "mobile-nav__link--active": active }]}
                    aria-current={active ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <div class="mobile-nav__foot">
        <a href={`mailto:${social.email}`} class="mobile-nav__email">{social.email}</a>
        <span class="mobile-nav__hint">Available for product-minded work</span>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-canvas) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: var(--border-hairline);
    /* Promote sticky to compositor layer only on capable devices; avoid continuous repaint */
    contain: layout paint;
  }

  /* Fallback when backdrop-filter unsupported */
  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--color-canvas);
    }
  }

  /* Mobile simplification: blur is expensive on low-end GPUs and coarse pointers — use solid */
  @media (max-width: 780px), (pointer: coarse) {
    .site-header {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--color-canvas);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--color-canvas); }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: var(--header-height);
    padding-block: var(--space-3);
  }

  .site-header__brand {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1;
    min-width: 0;
    text-decoration: none;
  }

  .site-header__name {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-header__meta {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .site-header__nav {
    margin-left: auto;
  }

  .site-header__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .site-header__link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-normal);
    color: var(--color-text-muted);
    border-radius: var(--radius-pill);
    transition: color var(--duration-fast) var(--ease-default),
      background var(--duration-fast) var(--ease-default);
  }

  .site-header__link:hover {
    color: var(--color-text);
    background: var(--color-surface-hover);
  }

  .site-header__link--active {
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header__menu {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    border: var(--border-hairline);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .site-header__menu-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 16px;
  }

  .site-header__menu-line {
    display: block;
    height: 1.75px;
    background: currentColor;
    border-radius: 999px;
    transition: transform var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }

  .site-header__menu[aria-expanded="true"] .site-header__menu-line:nth-child(1) {
    transform: translateY(5.75px) rotate(45deg);
  }
  .site-header__menu[aria-expanded="true"] .site-header__menu-line:nth-child(2) {
    opacity: 0;
  }
  .site-header__menu[aria-expanded="true"] .site-header__menu-line:nth-child(3) {
    transform: translateY(-5.75px) rotate(-45deg);
  }

  /* Mobile nav overlay */
  .mobile-nav {
    position: fixed;
    inset: var(--header-height) 0 0 0;
    background: var(--color-canvas);
    border-top: var(--border-hairline);
    padding: var(--space-8) 0 var(--space-12);
    overflow-y: auto;
    animation: mobileIn var(--duration-base) var(--ease-out);
  }

  .mobile-nav[hidden] {
    display: none !important;
  }

  @keyframes mobileIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-4);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.2;
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    transition: background var(--duration-fast) var(--ease-default),
      border-color var(--duration-fast) var(--ease-default);
  }

  .mobile-nav__link:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-strong);
  }

  .mobile-nav__link--active {
    background: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
    color: var(--color-accent);
  }

  .mobile-nav__link--active::after {
    content: "—";
    font-weight: 400;
    opacity: 0.6;
  }

  .mobile-nav__foot {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: var(--border-hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav__email {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
  }

  .mobile-nav__hint {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    letter-spacing: var(--tracking-wide);
  }

  /* Responsive */
  @media (max-width: 780px) {
    .site-header__nav {
      display: none;
    }
    .site-header__menu {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav {
      animation: none;
    }
  }
</style>

<script is:inline>
  function initMobileNav() {
    const btn = document.getElementById("menu-toggle");
    const nav = document.getElementById("mobile-nav");
    if (!btn || !nav) return;

    // Close helper always queries fresh nodes to avoid stale closures after swaps
    function getBtn() { return document.getElementById("menu-toggle"); }
    function getNav() { return document.getElementById("mobile-nav"); }

    function close() {
      const b = getBtn(); const n = getNav();
      if (!b || !n) return;
      b.setAttribute("aria-expanded", "false");
      b.setAttribute("aria-label", "Open menu");
      n.hidden = true;
      document.body.style.removeProperty("overflow");
      document.getElementById("main")?.removeAttribute("inert");
      document.querySelector("footer")?.removeAttribute("inert");
      // only focus if menu was open and user is still on page (avoid stealing focus after navigation)
      if (document.activeElement && n.contains(document.activeElement)) b.focus();
    }
    function open() {
      const b = getBtn(); const n = getNav();
      if (!b || !n) return;
      b.setAttribute("aria-expanded", "true");
      b.setAttribute("aria-label", "Close menu");
      n.hidden = false;
      document.body.style.overflow = "hidden";
      document.getElementById("main")?.setAttribute("inert", "");
      document.querySelector("footer")?.setAttribute("inert", "");
      const firstLink = n.querySelector("a");
      if (firstLink) firstLink.focus();
    }

    // Idempotent per-element bindings: use onclick assignment to overwrite stale listeners after swaps
    btn.onclick = () => {
      const b = getBtn();
      if (!b) return;
      const expanded = b.getAttribute("aria-expanded") === "true";
      if (expanded) close(); else open();
    };

    nav.querySelectorAll("a").forEach((a) => {
      a.onclick = () => {
        const b = getBtn();
        if (b && b.getAttribute("aria-expanded") === "true") close();
      };
    });

    // Backdrop click
    nav.onclick = (e) => {
      if (e.target === nav) close();
    };

    // Ensure closed state on fresh page (important after View Transition where old open state could leak)
    close();

    // Bind global handlers only once to avoid duplicates after repeated swaps
    if (!window.__mobileNavGlobals) {
      window.__mobileNavGlobals = true;
      const FOCUSABLE = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
      function trapFocus(e) {
        const b = getBtn(); const n = getNav();
        if (!b || !n) return;
        if (e.key !== "Tab") return;
        if (b.getAttribute("aria-expanded") !== "true") return;
        const focusables = Array.from(n.querySelectorAll(FOCUSABLE));
        if (focusables.length === 0) return;
        const first = focusables[0]; const last = focusables[focusables.length - 1];
        if (!first || !last) return;
        const active = document.activeElement;
        if (e.shiftKey && (active === first || !n.contains(active))) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault(); first.focus();
        }
      }
      document.addEventListener("keydown", (e) => {
        const b = getBtn();
        if (!b || b.getAttribute("aria-expanded") !== "true") return;
        if (e.key === "Escape") { e.preventDefault(); close(); }
        else trapFocus(e);
      });
      const mq = window.matchMedia("(min-width: 781px)");
      mq.addEventListener("change", (e) => {
        const b = getBtn();
        if (e.matches && b && b.getAttribute("aria-expanded") === "true") close();
      });
      // Also close on View Transition swaps that happen while open
      document.addEventListener("astro:before-swap", close);
      document.addEventListener("astro:after-swap", close);
    }
  }
  initMobileNav();
  document.addEventListener("astro:page-load", initMobileNav);
  document.addEventListener("astro:after-swap", initMobileNav);
</script>
