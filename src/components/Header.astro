---
import { isActiveNav, navigation, site } from '../data/site.ts'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  currentPath: string
}

const { currentPath } = Astro.props
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">DR</span>
      <span class="brand-text">
        <span class="brand-name">Danial Rashidi</span>
        <span class="brand-role">Software &amp; Product Builder</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActiveNav(item.href, currentPath) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <span class="status header-status" data-status="live">Open to work</span>
      <ThemeToggle />
      <button
        type="button"
        class="menu-button"
        data-menu-open
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="visually-hidden">Open menu</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 7h18M3 12h18M3 17h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <dialog class="menu" id="site-menu" aria-label="Site menu">
    <div class="menu-head">
      <span class="eyebrow">Menu</span>
      <button type="button" class="menu-close" data-menu-close>
        <span class="visually-hidden">Close menu</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Site">
      <ul class="menu-nav">
        {
          navigation.map((item, index) => (
            <li>
              <a
                href={item.href}
                aria-current={isActiveNav(item.href, currentPath) ? "page" : undefined}
              >
                <span class="menu-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu-foot">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href="https://danialrashidi.ir" hreflang="fa" lang="fa">نسخه فارسی</a>
    </div>
  </dialog>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-xs);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1;
    letter-spacing: -0.02em;
    transition: background-color var(--dur-fast) var(--ease);
  }

  .brand:hover .brand-mark {
    background: var(--accent);
    color: var(--on-accent);
  }

  .brand-text {
    display: grid;
    gap: 0.1rem;
    line-height: 1.1;
  }

  .brand-name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-role {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .desktop-nav {
    margin-inline-start: auto;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .desktop-nav a:hover {
    color: var(--ink);
    background: var(--bg-sunk);
  }

  .desktop-nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-inline-start: 0.5rem;
  }

  .header-status {
    margin-inline-end: 0.5rem;
    font-size: 0.6875rem;
  }

  .menu-button {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    background: var(--bg-raised);
    transition: border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .menu-button:hover {
    border-color: var(--line-strong);
    background: var(--bg-sunk);
  }

  /* Mobile menu: native dialog gives focus containment and Escape handling. */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100%;
    margin: 0;
    padding: calc(var(--header-h) + 1.25rem) var(--gutter) 2rem;
    border: 0;
    background: var(--bg);
    color: var(--ink);
    overflow-y: auto;
  }

  .menu::backdrop {
    background: rgb(0 0 0 / 0.35);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: menu-in var(--dur-base) var(--ease) both;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .menu-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    background: var(--bg-raised);
  }

  .menu-nav {
    display: grid;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }

  .menu-nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 8vw, 2.5rem);
    line-height: 1.1;
    text-decoration: none;
    color: var(--ink);
  }

  .menu-nav a[aria-current="page"] {
    color: var(--accent);
  }

  .menu-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .menu-foot {
    margin-top: auto;
    display: grid;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .menu-foot a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media (max-width: 1100px) {
    .header-status {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .desktop-nav {
      display: none;
    }

    .header-actions {
      margin-inline-start: auto;
    }

    .menu-button {
      display: grid;
    }
  }

  @media (min-width: 961px) {
    .menu {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .brand-role {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu[open] {
      animation: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const dialog = document.getElementById("site-menu");
    const openButton = document.querySelector("[data-menu-open]");
    if (!(dialog instanceof HTMLDialogElement) || !(openButton instanceof HTMLElement)) return;
    const closeButton = dialog.querySelector("[data-menu-close]");

    openButton.addEventListener("click", () => {
      dialog.showModal();
      openButton.setAttribute("aria-expanded", "true");
    });

    const close = () => {
      if (dialog.open) dialog.close();
    };

    closeButton?.addEventListener("click", close);

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    dialog.addEventListener("close", () => {
      openButton.setAttribute("aria-expanded", "false");
      openButton.focus();
    });
  })();
</script>
