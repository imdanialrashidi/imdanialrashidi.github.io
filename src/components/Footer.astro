---
import { navigation, products, site, socials } from '../data/site.ts'
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-cta">
        <p class="eyebrow">Start a conversation</p>
        <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="note">
          One direct inbox. No form, no tracker, no CRM. I read every message and
          usually reply within a day or two.
        </p>
      </div>

      <div class="footer-cols">
        <div>
          <p class="eyebrow">Site</p>
          <ul>
            {
              navigation.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
            <li><a href="/work/">All projects</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Building</p>
          <ul>
            {
              products.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
            <li>
              <a href="https://noveno.ir" rel="me noopener">Noveno.ir</a>
            </li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Elsewhere</p>
          <ul>
            {
              socials
                .filter((social) => social.id !== "email")
                .map((social) => (
                  <li>
                    <a
                      href={social.href}
                      rel={social.id === "email" ? undefined : "me noopener"}
                      lang={social.id === "persian" ? "fa" : undefined}
                    >
                      {social.label}
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2026 {site.name}. Built in Iran, hosted on GitHub Pages.</p>
      <p class="footer-note">
        Static HTML, no analytics, no cookies. The Persian home is
        <a href={site.persianSite} hreflang="fa" lang="fa">danialrashidi.ir</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 1.75rem;
    margin-top: var(--section-y);
    background: var(--bg-sunk);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }

  .footer-cta {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    max-width: 30rem;
  }

  .footer-email {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
    width: fit-content;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.15rem;
  }

  .footer-email:hover {
    color: var(--accent);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .footer-cols ul {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: grid;
    gap: 0.15rem;
  }

  .footer-cols a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .footer-cols a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .footer-note a {
    color: var(--ink-soft);
    text-decoration-color: var(--line-strong);
  }

  .footer-note a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem;
    }
  }
</style>
