---
import { social } from "../data/site.ts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__left">
      <div class="site-footer__brand">Danial Rashidi</div>
      <div class="site-footer__tagline">
        Software & Product Builder — Web · AI · Automation · Product Engineering
      </div>
      <div class="site-footer__copy">© {year} Danial Rashidi. Crafted with care.</div>
    </div>

    <div class="site-footer__right">
      <nav class="site-footer__nav" aria-label="External links">
        <a href={social.github} target="_blank" rel="me noopener noreferrer" class="site-footer__link"> GitHub </a>
        <a href={social.x} target="_blank" rel="me noopener noreferrer" class="site-footer__link"> X {social.xHandle} </a>
        <a href={social.instagram} target="_blank" rel="me noopener noreferrer" class="site-footer__link"> Instagram </a>
        <a href={social.telegram} target="_blank" rel="me noopener noreferrer" class="site-footer__link"> Telegram </a>
        <a href={`mailto:${social.email}`} class="site-footer__link site-footer__link--email"> {social.email} </a>
      </nav>
      <div class="site-footer__building">
        Building <a href={social.noveno} target="_blank" rel="noopener noreferrer" class="site-footer__noveno">Noveno ↗</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: var(--border-hairline);
    background: var(--color-surface);
    padding: var(--space-10) 0 var(--space-8);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-10);
    align-items: start;
  }

  .site-footer__brand {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  .site-footer__tagline {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    max-width: 32ch;
  }

  .site-footer__copy {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    justify-content: flex-end;
  }

  .site-footer__link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-default);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }

  .site-footer__link:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-border-strong);
  }

  .site-footer__link--email {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  .site-footer__building {
    margin-top: var(--space-4);
    text-align: right;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .site-footer__noveno {
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
  }

  .site-footer__noveno:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .site-footer__nav {
      justify-content: flex-start;
    }
    .site-footer__building {
      text-align: left;
    }
  }
</style>
