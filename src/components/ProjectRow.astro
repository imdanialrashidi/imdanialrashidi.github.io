---
import { Image } from 'astro:assets'
import { type ProjectEntry, coverFor, hrefFor } from '../lib/work.ts'
import ProjectPlate from './ProjectPlate.astro'

interface Props {
  entry: ProjectEntry
  index: number
}

const { entry, index } = Astro.props
const cover = coverFor(entry)
const titleId = `project-${entry.id}-title`
const summaryId = `project-${entry.id}-summary`
---

<article class="project-row">
  <div class="project-row__inner">
    <span class="project-row__index" aria-hidden="true">
      {String(index).padStart(2, "0")}
    </span>
    <div class="project-row__main">
      <span class="project-row__kicker" aria-hidden="true">{entry.data.kicker}</span>
      <h3 class="project-row__title" id={titleId}>{entry.data.title}</h3>
      <p class="project-row__summary" id={summaryId}>{entry.data.summary}</p>
      <p class="project-row__meta">
        <span>{entry.data.role}</span>
        <span>{entry.data.year}</span>
        <span class="status" data-status={entry.data.status}>{entry.data.statusLabel}</span>
      </p>
    </div>
    <div class="project-row__media" aria-hidden="true">
      {
        cover ? (
          <Image
            src={cover}
            alt=""
            widths={[320, 560, 800]}
            sizes="(max-width: 900px) 100vw, 320px"
            format="webp"
            quality={78}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <ProjectPlate entry={entry} compact />
        )
      }
    </div>
    <a
      class="project-row__stretched"
      href={hrefFor(entry)}
      aria-labelledby={titleId}
      aria-describedby={summaryId}
    >
      <span class="visually-hidden">View project</span>
    </a>
  </div>
</article>

<style>
  .project-row {
    border-top: 1px solid var(--line);
  }

  .project-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project-row__inner {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(13rem, 20rem);
    align-items: center;
    gap: 1rem 2rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    color: var(--ink);
  }

  .project-row__stretched {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-xs);
    font-size: 0;
    text-decoration: none;
  }

  .project-row__stretched:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .project-row__index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-faint);
    align-self: start;
    padding-top: 0.35rem;
    transition: color var(--dur-fast) var(--ease);
  }

  .project-row__main {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .project-row__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .project-row__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
    transition: text-decoration-color var(--dur-fast) var(--ease);
  }

  .project-row__summary {
    color: var(--ink-soft);
    max-width: 38rem;
    font-size: var(--text-base);
  }

  .project-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    color: var(--ink-faint);
  }

  .project-row__meta > span + span:not(.status)::before {
    content: "";
    display: inline-block;
    width: 0.2rem;
    height: 0.2rem;
    border-radius: 50%;
    background: var(--line-strong);
    margin-inline-end: 1rem;
    vertical-align: middle;
  }

  .project-row__meta .status {
    font-size: inherit;
  }

  .project-row__media {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    overflow: hidden;
    background: var(--bg-sunk);
    transition: border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .project-row__media img {
    width: 100%;
    height: auto;
    transition: transform var(--dur-slow) var(--ease);
  }

  /* Hover and keyboard focus share the same affordance. */
  .project-row__inner:hover .project-row__title,
  .project-row__inner:focus-within .project-row__title {
    text-decoration-color: var(--accent);
  }

  .project-row__inner:hover .project-row__index,
  .project-row__inner:focus-within .project-row__index {
    color: var(--accent);
  }

  .project-row__inner:hover .project-row__media,
  .project-row__inner:focus-within .project-row__media {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .project-row__inner:hover .project-row__media img {
    transform: scale(1.025);
  }

  @media (max-width: 900px) {
    .project-row__inner {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.75rem 1rem;
    }

    .project-row__media {
      grid-column: 1 / -1;
      margin-top: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row__media,
    .project-row__media img {
      transition: none;
    }
  }
</style>
