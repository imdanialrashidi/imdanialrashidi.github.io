---
import '../styles/global.css'
import portrait from '../assets/portrait/danial-portrait.webp'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { site } from '../data/site.ts'
import { type Breadcrumb, pageGraph } from '../lib/seo.ts'

interface Props {
  /** Page title without the brand suffix. Home passes the full site title. */
  title?: string
  description?: string
  /** Route path for the canonical URL. Defaults to the current URL path. */
  path?: string
  /** Social card path, e.g. "/og/work/noveno.jpg". */
  image?: string
  imageAlt?: string
  pageType?: 'WebPage' | 'ProfilePage' | 'CollectionPage' | 'ContactPage' | 'AboutPage'
  breadcrumbs?: Breadcrumb[]
  extraSchema?: Record<string, unknown>[]
  about?: { name: string; url?: string }
  mainEntity?: Record<string, unknown>
  updated?: string
  noIndex?: boolean
  ogType?: 'website' | 'article'
  publishedTime?: string
}

const {
  title,
  description = site.description,
  path,
  image = site.ogImage,
  imageAlt,
  pageType = 'WebPage',
  breadcrumbs,
  extraSchema,
  about,
  mainEntity,
  updated,
  noIndex = false,
  ogType = 'website',
  publishedTime,
} = Astro.props

const rawPath = path ?? Astro.url.pathname
// trailingSlash: "always". Canonical URLs, sitemap entries and every internal
// link use the same trailing-slash form so GitHub Pages never has to redirect.
const normalizedPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`
const canonical = `${site.url}${normalizedPath}`
const fullTitle = !title || title === site.title ? site.title : `${title} · ${site.shortTitle}`
const ogImageUrl = image.startsWith('http') ? image : `${site.url}${image}`
const ogImageAlt = imageAlt ?? `${site.shortTitle}, ${site.tagline}`
const robots = noIndex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
const jsonLd = pageGraph(
  {
    pageType,
    title: fullTitle,
    description,
    canonical,
    imageUrl: ogImageUrl,
    breadcrumbs,
    extra: extraSchema,
    about,
    mainEntity,
    updated,
  },
  portrait,
)
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11100e" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <!-- Public Search Console token, not a credential. -->
    <meta
      name="google-site-verification"
      content="EbxKFJ8aupZ_xX043IyEFa_ZJ3L8VQnQ75exp1yyMsE"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {[...new Set(["https://github.com/imdanialrashidi", "https://x.com/imdanialrashidi", "https://instagram.com/imdanialrashidi", "https://t.me/imdanialrashidi", site.persianSite])].map(
      (href) => <link rel="me" href={href} />,
    )}

    <!-- Display face preloads. Body sans is text-LCP critical; mono loads on demand. -->
    <link
      rel="preload"
      href="/fonts/instrument-serif-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={site.locale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updated && <meta property="article:modified_time" content={updated} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@imdanialrashidi" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      !noIndex && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <!-- Prefetch on intent; no runtime script. Chromium only, safely ignored elsewhere. -->
    {
      !noIndex && (
        <script
          is:inline
          type="speculationrules"
          set:html={JSON.stringify({
            prefetch: [
              {
                where: {
                  and: [
                    { href_matches: "/*" },
                    { not: { href_matches: "/404" } },
                    { not: { href_matches: "/*\\?*" } },
                  ],
                },
                eagerness: "moderate",
              },
            ],
          })}
        />
      )
    }

    <slot name="head" />

    <!-- Theme before first paint: stored choice, otherwise the system setting. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var system = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
          var theme = stored === "light" || stored === "dark" ? stored : system;
          document.documentElement.setAttribute("data-theme", theme);
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={normalizedPath} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
