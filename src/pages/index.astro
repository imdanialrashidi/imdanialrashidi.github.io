---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import heroPortrait from '../assets/portrait/danial-hero.webp'
import btsPortrait from '../assets/portrait/danial-night.webp'
import CtaBand from '../components/CtaBand.astro'
import ProjectFeature from '../components/ProjectFeature.astro'
import SectionHead from '../components/SectionHead.astro'
import TravelCard from '../components/TravelCard.astro'
import { site } from '../data/site.ts'
import Layout from '../layouts/Layout.astro'
import { itemListNode } from '../lib/seo.ts'
import { type TravelEntry, sortTravels } from '../lib/travels.ts'
import { featuredProjects, otherProjects, sortProjects } from '../lib/work.ts'

const projects = sortProjects(await getCollection('projects'))
const featured = featuredProjects(projects)
const others = otherProjects(projects, featured)
const travels = sortTravels(await getCollection('travels')).slice(0, 3)

const itemList = itemListNode(
  projects.map((entry) => ({
    name: entry.data.title,
    description: entry.data.summary,
    href: `/work/${entry.id}/`,
  })),
)

const capabilities = [
  {
    title: 'Product engineering',
    body: 'Web apps, progressive web apps, and Android tools built end to end: data model, interface, release, and the maintenance after it.',
  },
  {
    title: 'Client websites',
    body: 'Online stores, corporate sites, and education platforms for real businesses. Clear structure, fast pages, and content the owner can keep current.',
  },
  {
    title: 'Automation',
    body: 'Small systems that remove repeated manual work: scripts, integrations between tools, and workflows that keep running without a babysitter.',
  },
  {
    title: 'AI-assisted development',
    body: 'Coding models speed up implementation and research. Verification, architecture, and the final judgement stay with me.',
  },
]

const principles = [
  {
    title: 'Solve the actual problem',
    body: 'If a feature does not change the outcome for the person using it, it does not ship.',
  },
  {
    title: 'Ship early, then improve',
    body: 'A rough version in real use teaches more than a polished plan that never leaves the document.',
  },
  {
    title: 'AI is leverage, not judgement',
    body: 'Models make the work faster. They do not decide what is correct, and they are never the last reviewer.',
  },
  {
    title: 'Keep the system understandable',
    body: 'Plain structure and readable code are easier to hand over, easier to fix, and cheaper to keep alive.',
  },
]
---

<Layout
  title={site.title}
  description={site.description}
  path="/"
  image={site.ogImage}
  imageAlt="Danial Rashidi, software and product builder"
  pageType="ProfilePage"
  extraSchema={[itemList]}
  about={{ name: site.name, url: site.url }}
>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero__intro">
      <p class="eyebrow hero__eyebrow">
        <span class="hero__dot" aria-hidden="true"></span>
        Danial Rashidi · Software &amp; Product Builder · Iran
      </p>
      <h1 class="h1 hero__title" id="hero-title">
        From a vague idea to a <em>system that works.</em>
      </h1>
      <p class="lede hero__lede">
        I design and build software products, client websites, and the
        automations in between. Right now that means Noveno, Study Center and
        Gym Log, plus client work like Fast English and Kidotalks.
      </p>
      <p class="hero__actions">
        <a class="btn btn--primary" href="/work/">
          See the work
          <svg
            class="btn__arrow"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path>
          </svg>
        </a>
        <a class="btn btn--outline" href="/contact/">Start a conversation</a>
      </p>
      <dl class="hero__meta">
        <div>
          <dt>Based in</dt>
          <dd>Iran, working remotely</dd>
        </div>
        <div>
          <dt>Building</dt>
          <dd>Noveno, Study Center, Gym Log, Fast English, Kidotalks</dd>
        </div>
        <div>
          <dt>Open to</dt>
          <dd>{site.availability}</dd>
        </div>
        <div>
          <dt>Persian site</dt>
          <dd>
            <a href={site.persianSite} hreflang="fa" lang="fa">danialrashidi.ir</a>
          </dd>
        </div>
      </dl>
    </div>

    <figure class="hero__portrait">
      <Image
        src={heroPortrait}
        alt="Studio portrait of Danial Rashidi in a navy suit and white shirt"
        widths={[320, 480, 640, 750]}
        sizes="(max-width: 900px) 90vw, 420px"
        format="webp"
        quality={84}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <figcaption>
        <span>Danial Rashidi</span>
        <span>Iran, 2026</span>
      </figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="selected-title">
    <div class="container">
      <SectionHead
        index="01"
        title="Selected work"
        id="selected-title"
        note="Three builds with real screenshots and honest status. The full index groups products and client work."
        href="/work/"
        linkLabel="All nine projects"
      />
      <div class="features">
        {
          featured.map((entry, i) => (
            <ProjectFeature
              entry={entry}
              index={i + 1}
              flip={i % 2 === 1}
              priority={false}
            />
          ))
        }
      </div>

      <div class="more-work">
        <p class="eyebrow">Also in the index</p>
        <ul class="more-work__list">
          {
            others.map((entry) => (
              <li>
                <a href={`/work/${entry.id}/`}>
                  <span class="more-work__title">{entry.data.title}</span>
                  <span class="more-work__meta">
                    {entry.data.kind === "product" ? "Product" : "Client"} ·{" "}
                    {entry.data.year} · {entry.data.statusLabel}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="capabilities-title">
    <div class="container">
      <SectionHead
        index="02"
        title="What I do"
        id="capabilities-title"
        note="A small set of things done properly, rather than a long list of everything."
      />
      <dl class="cap-list">
        {
          capabilities.map((item, i) => (
            <div class="cap">
              <dt>
                <span class="cap__num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="cap__title">{item.title}</span>
              </dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="container">
      <SectionHead
        index="03"
        title="How I work"
        id="principles-title"
        note="Four rules that decide what gets built and what gets cut."
      />
      <ol class="principles">
        {
          principles.map((item, i) => (
            <li>
              <span class="principles__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="principles__title">{item.title}</h3>
              <p class="principles__body">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="travels-title">
    <div class="container">
      <SectionHead
        index="04"
        title="Off the clock"
        id="travels-title"
        note="Mountains, canyons, and caves. The work is better when life outside the editor is real."
        href="/travels/"
        linkLabel="All travel notes"
      />
      <div class="travels">
        {travels.map((entry: TravelEntry) => <TravelCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="about-band" aria-labelledby="about-teaser-title">
    <div class="container about-band__inner">
      <div class="about-band__portrait">
        <Image
          src={btsPortrait}
          alt="Danial Rashidi at night, next to a large yellow sculpture wearing sunglasses"
          widths={[280, 420, 480]}
          sizes="(max-width: 760px) 40vw, 240px"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-band__body">
        <p class="eyebrow">About</p>
        <h2 class="h2 about-band__title" id="about-teaser-title">
          I have been building for the web since 2024, first for businesses, now
          mostly for products I own.
        </h2>
        <p class="about-band__text">
          The path went from writing code to owning the whole problem: what is
          being built, for whom, and what happens after launch. The full page
          covers how I work, what I am learning, and the parts of life that are
          not software.
        </p>
        <p class="about-band__links">
          <a class="link" href="/about/">More about me</a>
          <a class="link link--quiet" href="/now/">What I am doing now</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* ------------------------------------------------------------------ hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .hero__intro {
    display: grid;
    gap: 1.25rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--status-live);
    flex: none;
  }

  .hero__title {
    font-size: clamp(2.9rem, 7.4vw, 6.25rem);
    max-width: 14ch;
  }

  .hero__title em {
    font-style: italic;
    color: var(--accent);
  }

  .hero__lede {
    max-width: 38rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .hero__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 2rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .hero__meta dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .hero__meta dd {
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    max-width: 22rem;
  }

  .hero__meta a {
    color: var(--ink-soft);
    text-decoration-color: var(--line-strong);
  }

  .hero__meta a:hover {
    color: var(--accent);
  }

  .hero__portrait {
    display: grid;
    gap: 0.6rem;
    align-self: end;
  }

  .hero__portrait img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 2px rgb(var(--shadow) / 0.04),
      0 24px 48px -30px rgb(var(--shadow) / 0.3);
  }

  .hero__portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* ---------------------------------------------------------- selected work */
  .features {
    display: grid;
  }

  .more-work {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .more-work__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 3rem);
  }

  .more-work__list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }

  .more-work__list {
    border-bottom: 1px solid var(--line);
  }

  .more-work__title {
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease);
  }

  .more-work__list a:hover .more-work__title {
    color: var(--accent);
  }

  .more-work__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: right;
    white-space: nowrap;
  }

  /* ------------------------------------------------------------ capabilities */
  .cap-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .cap {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .cap:last-child,
  .cap:nth-last-child(2) {
    border-bottom: 1px solid var(--line);
  }

  .cap dt {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .cap__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--accent);
  }

  .cap__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    line-height: 1.15;
    color: var(--ink);
  }

  .cap dd {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    max-width: 34rem;
  }

  /* -------------------------------------------------------------- principles */
  .principles {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    counter-reset: none;
  }

  .principles li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 1rem;
    row-gap: 0.4rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .principles li:nth-child(even) {
    padding-inline-start: clamp(1rem, 3vw, 2.5rem);
  }

  .principles__num {
    grid-row: 1 / 3;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--accent);
  }

  .principles__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .principles__body {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    max-width: 28rem;
  }

  /* ------------------------------------------------------------------ travels */
  .travels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
  }

  /* ------------------------------------------------------------- about teaser */
  .about-band {
    background: var(--bg-sunk);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: var(--section-y);
  }

  .about-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.5fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }

  .about-band__portrait img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .about-band__body {
    display: grid;
    gap: 1rem;
  }

  .about-band__title {
    max-width: 26ch;
  }

  .about-band__text {
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .about-band__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.5rem;
  }

  .about-band__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 500;
  }

  /* ---------------------------------------------------------------- responsive */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero__portrait {
      max-width: 26rem;
      order: -1;
    }

    .hero__portrait img {
      max-height: 34rem;
      object-fit: cover;
    }

    .more-work__list,
    .cap-list,
    .principles {
      grid-template-columns: 1fr;
    }

    .cap:last-child {
      border-bottom: 1px solid var(--line);
    }

    .cap:nth-last-child(2) {
      border-bottom: 0;
    }

    .principles li:nth-child(even) {
      padding-inline-start: 0;
    }

    .travels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-band__inner {
      grid-template-columns: 1fr;
    }

    .about-band__portrait {
      max-width: 12rem;
    }
  }

  @media (max-width: 560px) {
    .more-work__list a {
      flex-wrap: wrap;
    }

    .more-work__meta {
      white-space: normal;
      text-align: left;
    }

    .travels {
      grid-template-columns: 1fr;
    }

    .hero__meta {
      grid-template-columns: 1fr;
    }

    .hero__portrait {
      order: 0;
      max-width: 100%;
    }
  }
</style>
