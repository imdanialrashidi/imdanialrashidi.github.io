---
import SocialIcon from '../components/SocialIcon.astro'
import { site, socials } from '../data/site.ts'
import Layout from '../layouts/Layout.astro'
import { HOME_TRAIL } from '../lib/seo.ts'

const description =
  'Email, GitHub, X, Instagram and Telegram for Danial Rashidi. Open to remote software work, product collaborations and business websites. No form, no tracker.'

const help = [
  {
    title: 'Software and product work',
    body: 'Web apps, internal tools, and product engineering. Most useful when the problem is still fuzzy and needs to be made concrete.',
  },
  {
    title: 'Business websites',
    body: 'Stores, corporate sites, and education platforms: design, implementation, and the parts that make a site maintainable after launch.',
  },
  {
    title: 'Automation',
    body: 'Repeated manual work that can be scripted, connected, or removed. Small projects are fine.',
  },
]

const primaryEmail = `mailto:${site.email}`
const secondary = socials.filter((social) => social.id !== 'email')
---

<Layout
  title="Contact: email, GitHub and Telegram"
  description={description}
  path="/contact/"
  image="/og/contact.jpg"
  imageAlt="Contact Danial Rashidi"
  pageType="ContactPage"
  breadcrumbs={[HOME_TRAIL, { name: "Contact", href: "/contact/" }]}
  extraSchema={[
    {
      "@type": "ContactPoint",
      "@id": `${site.url}/contact/#email`,
      email: site.email,
      contactType: "professional enquiries",
      availableLanguage: ["English", "Persian"],
    },
  ]}
  about={{ name: site.name, url: site.url }}
>
  <header class="container contact-hero">
    <p class="eyebrow eyebrow--accent">Contact</p>
    <h1 class="h1 contact-hero__title">
      Let's build something <em>useful.</em>
    </h1>
    <p class="lede contact-hero__lede">
      Open to remote software work, product collaborations, and business
      websites that need to be done properly. Email reaches me directly, and I
      reply within a day or two.
    </p>
    <p class="contact-hero__email">
      <a href={primaryEmail}>{site.email}</a>
    </p>
    <p class="contact-hero__meta">
      <span>No form</span>
      <span>No tracker</span>
      <span>Direct email</span>
    </p>
  </header>

  <section class="container contact-help" aria-labelledby="help-title">
    <h2 class="h2 contact-section-title" id="help-title">What I can help with</h2>
    <dl class="help-list">
      {
        help.map((item, i) => (
          <div>
            <dt>
              <span class="help-list__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              {item.title}
            </dt>
            <dd>{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container contact-links" aria-labelledby="links-title">
    <div class="contact-links__intro">
      <h2 class="h2 contact-section-title" id="links-title">Other channels</h2>
      <p class="note">
        Email is the primary route. These work too, and they are the same
        profiles listed in the site's structured data.
      </p>
    </div>
    <ul class="channel-list">
      {
        secondary.map((social) => (
          <li>
            <a
              href={social.href}
              rel={social.id === "persian" ? "me" : "me noopener"}
              lang={social.id === "persian" ? "fa" : undefined}
            >
              <SocialIcon id={social.id} size={18} />
              <span class="channel-list__label">{social.label}</span>
              <span class="channel-list__handle" dir="ltr">{social.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container contact-notes" aria-labelledby="notes-title">
    <h2 class="h2 contact-section-title" id="notes-title">Before you write</h2>
    <ul class="dot-list">
      <li>The fastest reply comes from a short message with the problem, the deadline if there is one, and a link to whatever already exists.</li>
      <li>I answer in English or Persian. The Persian site is <a class="link" href={site.persianSite} hreflang="fa" lang="fa">danialrashidi.ir</a>.</li>
      <li>No analytics, no cookies, and no backend on this site. Email is not tracked either.</li>
    </ul>
  </section>
</Layout>

<style>
  .contact-hero {
    display: grid;
    gap: 1.15rem;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .contact-hero__title {
    font-size: clamp(2.75rem, 7.5vw, 6rem);
    max-width: 15ch;
  }

  .contact-hero__title em {
    font-style: italic;
    color: var(--accent);
  }

  .contact-hero__lede {
    max-width: 36rem;
  }

  .contact-hero__email {
    margin-top: 0.75rem;
  }

  .contact-hero__email a {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 0.15rem;
    overflow-wrap: anywhere;
  }

  .contact-hero__email a:hover {
    color: var(--accent);
  }

  .contact-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .contact-hero__meta span + span::before {
    content: "";
    display: inline-block;
    width: 0.2rem;
    height: 0.2rem;
    border-radius: 50%;
    background: var(--line-strong);
    margin-inline-end: 1.5rem;
    vertical-align: middle;
  }

  .contact-section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .contact-help {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .help-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: 0.75rem;
  }

  .help-list dt {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    line-height: 1.15;
    color: var(--ink);
  }

  .help-list__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--accent);
  }

  .help-list dd {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .contact-links {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .contact-links__intro {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .channel-list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .channel-list li {
    border-top: 1px solid var(--line);
  }

  .channel-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .channel-list a {
    display: grid;
    grid-template-columns: 1.25rem 8rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.75rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .channel-list a:hover {
    color: var(--accent);
  }

  .channel-list__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .channel-list__handle {
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    justify-self: end;
    text-align: right;
  }

  .contact-notes {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .dot-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .dot-list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--ink-soft);
    max-width: 40rem;
  }

  .dot-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .help-list {
      grid-template-columns: 1fr;
    }

    .contact-links {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .channel-list a {
      grid-template-columns: 1.25rem minmax(0, 1fr);
      row-gap: 0.15rem;
    }

    .channel-list__handle {
      grid-column: 2;
      justify-self: start;
      text-align: left;
    }
  }
</style>
