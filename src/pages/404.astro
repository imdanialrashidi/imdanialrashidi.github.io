---
import { site } from '../data/site.ts'
import Layout from '../layouts/Layout.astro'

const description =
  'That page does not exist. Start from the work, the travels, or send an email directly: imdanialrashidi@gmail.com.'
---

<Layout title="Page not found" description={description} noIndex>
  <section class="not-found container">
    <p class="eyebrow eyebrow--accent">404</p>
    <h1 class="h1 not-found__title">Wrong turn.</h1>
    <p class="lede not-found__lede">
      The page you asked for is not here. It may have moved, or never existed
      in the first place. These are the routes that do.
    </p>
    <ul class="not-found__links">
      <li><a class="link" href="/work/">See the work</a></li>
      <li><a class="link" href="/travels/">Travel notes</a></li>
      <li><a class="link" href="/about/">About me</a></li>
      <li><a class="link" href="/contact/">Contact</a></li>
    </ul>
    <p class="not-found__email">
      Or go straight to <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>
</Layout>

<style>
  .not-found {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(4rem, 10vw, 8rem);
    max-width: 44rem;
  }

  .not-found__title {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.92;
  }

  .not-found__lede {
    max-width: 32rem;
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    list-style: none;
    padding: 1.25rem 0 0;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .not-found__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-lg);
  }

  .not-found__email {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }
</style>
