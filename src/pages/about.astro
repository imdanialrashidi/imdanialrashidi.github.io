---
import { Image } from 'astro:assets'
import portrait from '../assets/portrait/danial-portrait.webp'
import CtaBand from '../components/CtaBand.astro'
import { site } from '../data/site.ts'
import Layout from '../layouts/Layout.astro'
import { HOME_TRAIL } from '../lib/seo.ts'

const description =
  'Danial Rashidi is a software and product builder from Iran: client websites, products he owns, how he works, and life outside the editor.'

const timeline = [
  {
    year: '2024',
    title: 'Client websites',
    body: 'Four businesses: an online phone store, a safety inspection company, a second store, and a language institute in Karaj. Design and implementation, shipped.',
    links: [
      { label: 'Elsa Hamrah', href: '/work/elsa-hamrah/' },
      { label: 'Isbatab', href: '/work/isbatab/' },
      { label: 'PHP IELTS House', href: '/work/php-ielts-house/' },
    ],
  },
  {
    year: '2025',
    title: 'Noveno and the move to products',
    body: 'I started building my own systems instead of only client sites. Noveno is the umbrella: less talk, more working software, released in small pieces.',
    links: [{ label: 'Noveno', href: '/work/noveno/' }],
  },
  {
    year: '2026',
    title: 'Products in use',
    body: 'Study Center, Fast English, and Gym Log. Different platforms, the same rule: the thing has to run in the real world, not just in a plan.',
    links: [
      { label: 'Study Center', href: '/work/study/' },
      { label: 'Fast English', href: '/work/fast-english/' },
      { label: 'Gym Log', href: '/work/gym-log/' },
    ],
  },
]

const working = [
  {
    title: 'The real problem first',
    body: 'I write down what is actually broken before writing any code. A feature that does not change the outcome gets cut.',
  },
  {
    title: 'Working software early',
    body: 'A runnable version gets tested against reality sooner. Plans are useful, but they are not evidence.',
  },
  {
    title: 'AI as leverage',
    body: 'I use coding models for research, implementation, and debugging, and I review what comes back. The judgement and the last check stay human.',
  },
  {
    title: 'Simple enough to hand over',
    body: 'Readable code and plain structure survive maintenance, and they are cheaper for whoever touches the project next.',
  },
]
---

<Layout
  title="About: software and product builder"
  description={description}
  path="/about/"
  image="/og/about.jpg"
  imageAlt="Portrait of Danial Rashidi, software and product builder"
  pageType="AboutPage"
  breadcrumbs={[HOME_TRAIL, { name: "About", href: "/about/" }]}
  about={{ name: site.name, url: site.url }}
>
  <header class="container about-hero">
    <div>
      <p class="eyebrow eyebrow--accent">About</p>
      <h1 class="h1 about-hero__title">Danial Rashidi</h1>
      <p class="lede about-hero__lede">
        Software and product builder in Iran. I take a vague idea and turn it
        into a system someone can use, then stay with it long enough to find out
        whether it actually works.
      </p>
      <dl class="about-hero__facts">
        <div>
          <dt>Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Software, product, automation</dd>
        </div>
        <div>
          <dt>Open to</dt>
          <dd>{site.availability}</dd>
        </div>
        <div>
          <dt>Right now</dt>
          <dd>Noveno, Study Center, Fast English, Gym Log</dd>
        </div>
      </dl>
    </div>
    <figure class="about-hero__portrait">
      <Image
        src={portrait}
        alt="Portrait of Danial Rashidi"
        widths={[320, 480, 640]}
        sizes="(max-width: 860px) 70vw, 320px"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <figcaption>Danial Rashidi, {site.location}</figcaption>
    </figure>
  </header>

  <section class="section" aria-labelledby="path-title">
    <div class="container">
      <h2 class="h2 about-section-title" id="path-title">The path so far</h2>
      <p class="note">
        Short version: client work taught me what a working system has to do,
        product work taught me that nobody will tell you when it is finished.
      </p>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li>
              <span class="timeline__year">{item.year}</span>
              <h3 class="timeline__title">{item.title}</h3>
              <p class="timeline__body">{item.body}</p>
              <ul class="timeline__links">
                {item.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="methods-title">
    <div class="container methods">
      <div class="methods__intro">
        <h2 class="h2 about-section-title" id="methods-title">How I work</h2>
        <p class="methods__text">
          Calm, precise, and biased toward shipping. I care more about systems
          that keep working than demos that look good once.
        </p>
        <p class="methods__text">
          AI is part of the workflow: implementation, research, debugging, and
          the repetitive parts of building. It is not part of the judgement.
          Anything that models produce is reviewed before it ships, and nothing
          is presented as verified because a tool suggested it.
        </p>
      </div>
      <ol class="methods__list">
        {
          working.map((item, i) => (
            <li>
              <span class="methods__num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="methods__title">{item.title}</h3>
              <p class="methods__body">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="now-title">
    <div class="container now-block">
      <div>
        <h2 class="h2 about-section-title" id="now-title">What I am doing now</h2>
        <p class="now-block__text">
          Most of the week goes into Noveno and the products around it. Fast
          English and Kidotalks are client builds in development, Study Center
          grows course by course, and Gym Log is released and maintained. The
          now page records the current state honestly.
        </p>
        <p class="now-block__links">
          <a class="link" href="/now/">Read the now page</a>
          <a class="link link--quiet" href="/work/">See the work</a>
        </p>
      </div>
      <div>
        <h2 class="h2 about-section-title">Beyond software</h2>
        <p class="now-block__text">
          Mountains, canyoning, camping, music, and street photography. I also
          joined a cave survey for national registration, which is the closest
          thing to software I have found: patient measurement, careful
          teamwork, and respect for the thing you are mapping.
        </p>
        <p class="now-block__links">
          <a class="link" href="/travels/">Travel notes and photos</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="elsewhere-title">
    <div class="container elsewhere">
      <div>
        <h2 class="h2 about-section-title" id="elsewhere-title">Elsewhere</h2>
        <p class="note">
          The quickest route is email. The rest is where the work and the photos
          end up.
        </p>
      </div>
      <ul class="elsewhere__list">
        <li>
          <a href={`mailto:${site.email}`}>
            <span class="elsewhere__label">Email</span>
            <span class="elsewhere__value">{site.email}</span>
          </a>
        </li>
        <li>
          <a href="https://github.com/imdanialrashidi" rel="me noopener">
            <span class="elsewhere__label">GitHub</span>
            <span class="elsewhere__value">github.com/imdanialrashidi</span>
          </a>
        </li>
        <li>
          <a href="https://x.com/imdanialrashidi" rel="me noopener">
            <span class="elsewhere__label">X</span>
            <span class="elsewhere__value">@imdanialrashidi</span>
          </a>
        </li>
        <li>
          <a href="https://instagram.com/imdanialrashidi" rel="me noopener">
            <span class="elsewhere__label">Instagram</span>
            <span class="elsewhere__value">@imdanialrashidi</span>
          </a>
        </li>
        <li>
          <a href={site.persianSite} hreflang="fa" lang="fa">
            <span class="elsewhere__label">Persian site</span>
            <span class="elsewhere__value">danialrashidi.ir</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .about-hero__title {
    margin-top: 0.35rem;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.92;
  }

  .about-hero__lede {
    margin-top: 1.25rem;
    max-width: 36rem;
  }

  .about-hero__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 2rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .about-hero__facts dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .about-hero__facts dd {
    margin-top: 0.15rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    max-width: 22rem;
  }

  .about-hero__portrait {
    display: grid;
    gap: 0.6rem;
    justify-self: end;
    max-width: 22rem;
  }

  .about-hero__portrait img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .about-hero__portrait figcaption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .about-section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 0.85rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    column-gap: clamp(1rem, 3vw, 2rem);
    row-gap: 0.4rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .timeline li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .timeline__year {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--accent);
  }

  .timeline__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .timeline__body {
    grid-column: 2;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    max-width: 40rem;
  }

  .timeline__links {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0.25rem 0 0;
  }

  .timeline__links a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: fit-content;
    min-height: 2.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }

  .timeline__links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .methods {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .methods__text {
    color: var(--ink-soft);
    margin-top: 1rem;
    max-width: 34rem;
  }

  .methods__list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .methods__list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.35rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .methods__list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .methods__num {
    grid-row: 1 / 3;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--accent);
    line-height: 1.2;
  }

  .methods__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.15;
    color: var(--ink);
  }

  .methods__body {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    max-width: 30rem;
  }

  .now-block {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
  }

  .now-block__text {
    color: var(--ink-soft);
    max-width: 32rem;
  }

  .now-block__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  .now-block__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 500;
  }

  .elsewhere {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .elsewhere__list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .elsewhere__list li {
    border-top: 1px solid var(--line);
  }

  .elsewhere__list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .elsewhere__list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: 3rem;
    padding-block: 0.85rem;
    text-decoration: none;
    color: var(--ink);
  }

  .elsewhere__list a:hover {
    color: var(--accent);
  }

  .elsewhere__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .elsewhere__value {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .about-hero,
    .methods,
    .now-block,
    .elsewhere {
      grid-template-columns: 1fr;
    }

    .about-hero__portrait {
      justify-self: start;
      max-width: 16rem;
    }
  }

  @media (max-width: 560px) {
    .timeline li {
      grid-template-columns: 1fr;
    }

    .timeline__body,
    .timeline__links {
      grid-column: 1;
    }

    .about-hero__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
