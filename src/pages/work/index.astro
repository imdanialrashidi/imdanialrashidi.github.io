---
import { getCollection } from 'astro:content'
import CtaBand from '../../components/CtaBand.astro'
import ProjectRow from '../../components/ProjectRow.astro'
import SectionHead from '../../components/SectionHead.astro'
import { site } from '../../data/site.ts'
import Layout from '../../layouts/Layout.astro'
import { HOME_TRAIL, WORK_TRAIL, itemListNode } from '../../lib/seo.ts'
import { type ProjectEntry, byKind, sortProjects } from '../../lib/work.ts'

const projects = await getCollection('projects')
const ordered = sortProjects(projects)
const productProjects = byKind(projects, 'product')
const clientProjects = byKind(projects, 'client')
const years = ordered.map((entry: ProjectEntry) => entry.data.year)
const firstYear = Math.min(...years)
const lastYear = Math.max(...years)

const description =
  'Eight projects by Danial Rashidi: Noveno, Fast English, Study Center and Gym Log, plus four client websites. Case studies with real screenshots and honest limits.'

const itemList = itemListNode(
  ordered.map((entry) => ({
    name: entry.data.title,
    description: entry.data.summary,
    href: `/work/${entry.id}/`,
  })),
)
---

<Layout
  title="Work: software and web projects"
  description={description}
  path="/work/"
  image="/og/work.jpg"
  imageAlt="Work index: Danial Rashidi's product and client projects"
  pageType="CollectionPage"
  breadcrumbs={[HOME_TRAIL, WORK_TRAIL]}
  extraSchema={[itemList]}
  mainEntity={{ "@type": "ItemList", "@id": `${site.url}/work/#projects` }}
>
  <header class="container page-hero">
    <p class="eyebrow eyebrow--accent">Portfolio index</p>
    <h1 class="h1 page-hero__title">Work</h1>
    <p class="lede page-hero__lede">
      Eight projects: four products I own and build, and four websites made for
      businesses. Every preview below is a real screenshot, and every status
      says where the work actually stands.
    </p>
    <dl class="page-stats">
      <div>
        <dt>Products</dt>
        <dd>{String(productProjects.length).padStart(2, "0")}</dd>
      </div>
      <div>
        <dt>Client sites</dt>
        <dd>{String(clientProjects.length).padStart(2, "0")}</dd>
      </div>
      <div>
        <dt>Period</dt>
        <dd>{firstYear} to {lastYear}</dd>
      </div>
    </dl>
  </header>

  <section class="container work-group" aria-labelledby="products-title">
    <SectionHead
      index="01"
      title="Products I own"
      note="Built, shipped, and maintained by me. The case studies include what is finished, what is still moving, and what is deliberately out of scope."
      id="products-title"
    />
    <div class="work-list">
      {
        productProjects.map((entry, i) => (
          <ProjectRow entry={entry} index={i + 1} />
        ))
      }
    </div>
  </section>

  <section class="container work-group" aria-labelledby="clients-title">
    <SectionHead
      index="02"
      title="Client work"
      note="Websites designed and built for real businesses: stores, a safety inspection company, and a language institute. Scope and limits are stated per project."
      id="clients-title"
    />
    <div class="work-list">
      {
        clientProjects.map((entry, i) => (
          <ProjectRow entry={entry} index={productProjects.length + i + 1} />
        ))
      }
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .page-hero {
    display: grid;
    gap: 1.1rem;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .page-hero__title {
    font-size: clamp(3.25rem, 9vw, 7rem);
    line-height: 0.9;
  }

  .page-hero__lede {
    max-width: 40rem;
  }

  .page-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .page-stats dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .page-stats dd {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--ink);
  }

  .work-group {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
</style>
