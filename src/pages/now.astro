---
import CtaBand from '../components/CtaBand.astro'
import { site } from '../data/site.ts'
import Layout from '../layouts/Layout.astro'
import { HOME_TRAIL } from '../lib/seo.ts'

const updated = '2026-11-23'
const updatedLabel = '23 November 2026'

const description =
  'What Danial Rashidi is doing now: building Noveno, Study Center, Fast English and Gym Log, what he is learning, and what he is open to.'

const currently = [
  {
    label: 'Building',
    title: 'Noveno',
    body: 'The main project: customer-acquisition systems for small businesses, built one working piece at a time. The site is live, the rest is still moving.',
    links: [
      { label: 'Case study', href: '/work/noveno/' },
      { label: 'noveno.ir', href: 'https://noveno.ir' },
    ],
  },
  {
    label: 'Growing',
    title: 'Study Center',
    body: 'Interactive course websites for subjects that are hard to learn from a textbook. Each course is its own site, and new ones are added as they are finished.',
    links: [{ label: 'Case study', href: '/work/study/' }],
  },
  {
    label: 'In development',
    title: 'Fast English',
    body: 'A focused English-learning product for Persian speakers: web first, then Android. Still in development, and the case study says exactly what is open.',
    links: [{ label: 'Case study', href: '/work/fast-english/' }],
  },
  {
    label: 'Maintaining',
    title: 'Gym Log',
    body: 'The offline Android workout journal I use myself. Version 0.2.1 is released under the MIT license, and it gets fixes when real use finds problems.',
    links: [
      { label: 'Case study', href: '/work/gym-log/' },
      { label: 'GitHub', href: 'https://github.com/imdanialrashidi/gym-log' },
    ],
  },
]

const learning = [
  'Stronger TypeScript and backend foundations, especially around data models that survive real use.',
  'Product engineering: deciding what not to build, and how to scope a release honestly.',
  'AI-assisted workflows where the leverage is real, without handing over verification.',
]

const openTo = [
  'Remote software work and product collaborations.',
  'Business websites that need to be fast, clear, and easy to maintain.',
  'Small automation projects that remove repeated manual work.',
]
---

<Layout
  title="Now: what I am working on"
  description={description}
  path="/now/"
  image="/og/now.jpg"
  imageAlt="What Danial Rashidi is working on now"
  pageType="WebPage"
  breadcrumbs={[HOME_TRAIL, { name: "Now", href: "/now/" }]}
  updated={updated}
  about={{ name: site.name, url: site.url }}
>
  <header class="container now-hero">
    <p class="eyebrow eyebrow--accent">Now</p>
    <h1 class="h1 now-hero__title">What I am doing now</h1>
    <p class="lede now-hero__lede">
      A snapshot, not a roadmap. Last updated
      <time datetime={updated}>{updatedLabel}</time>. If this page looks old, I
      am heads-down on something.
    </p>
    <p class="now-hero__note">
      This page follows the <a class="link" href="https://nownownow.com/about" rel="noopener">now page</a>
      convention.
    </p>
  </header>

  <section class="container now-section" aria-labelledby="building-title">
    <h2 class="h2 now-section__title" id="building-title">Building</h2>
    <ol class="current-list">
      {
        currently.map((item, i) => (
          <li>
            <span class="current-list__num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div class="current-list__body">
              <p class="eyebrow">{item.label}</p>
              <h3 class="current-list__title">{item.title}</h3>
              <p class="current-list__text">{item.body}</p>
              <ul class="current-list__links">
                {item.links.map((link) => (
                  <li>
                    <a href={link.href} rel={link.href.startsWith("http") ? "noopener" : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container now-columns">
    <div class="now-column" aria-labelledby="learning-title">
      <h2 class="h2 now-section__title" id="learning-title">Learning</h2>
      <ul class="dot-list">
        {learning.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="now-column" aria-labelledby="open-title">
      <h2 class="h2 now-section__title" id="open-title">Open to</h2>
      <ul class="dot-list">
        {openTo.map((item) => <li>{item}</li>)}
      </ul>
      <p class="now-column__cta">
        <a class="btn btn--primary" href="/contact/">Start a conversation</a>
      </p>
    </div>
  </section>

  <section class="container now-section now-based" aria-labelledby="based-title">
    <h2 class="h2 now-section__title" id="based-title">Based in</h2>
    <p class="now-based__text">
      {site.location}, working remotely with people elsewhere. The Persian home
      of this site is <a class="link" href={site.persianSite} hreflang="fa" lang="fa">danialrashidi.ir</a>.
    </p>
  </section>

  <CtaBand />
</Layout>

<style>
  .now-hero {
    display: grid;
    gap: 1rem;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .now-hero__title {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    max-width: 14ch;
  }

  .now-hero__lede {
    max-width: 38rem;
  }

  .now-hero__note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .now-section {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .now-section__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .current-list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
  }

  .current-list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-block: clamp(1rem, 3vw, 1.75rem);
    border-top: 1px solid var(--line);
  }

  .current-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .current-list__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--accent);
    line-height: 1.2;
  }

  .current-list__body {
    display: grid;
    gap: 0.4rem;
    max-width: 44rem;
  }

  .current-list__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .current-list__text {
    color: var(--ink-soft);
    font-size: var(--text-base);
  }

  .current-list__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0.25rem 0 0;
  }

  .current-list__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .current-list__links a:hover {
    color: var(--accent);
  }

  .now-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .dot-list {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: grid;
    gap: 0.85rem;
  }

  .dot-list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--ink-soft);
    max-width: 32rem;
  }

  .dot-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .now-column__cta {
    margin-top: 1.5rem;
  }

  .now-based {
    display: grid;
    gap: 0.75rem;
  }

  .now-based__text {
    color: var(--ink-soft);
    max-width: 38rem;
  }

  @media (max-width: 760px) {
    .now-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
